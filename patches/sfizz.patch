+static std::string cleanUpV1Aliases(std::string opcode)
+{
+    for (absl::string_view prefix : { "fileg_depthcc", "pitcheg_depthcc" }) {
+        absl::string_view rest = absl::string_view(opcode).substr(std::min(opcode.size(), prefix.size()));
+        if (absl::StartsWith(opcode, prefix) && !rest.empty() && rest.find_first_not_of("0123456789") == rest.npos)
+            return absl::StrCat(prefix.substr(0, prefix.size() - 2), "_oncc", rest);
+    }
+    return opcode;
