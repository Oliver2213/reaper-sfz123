+sfz::Region::Variable* sfz::Region::getOrCreateVariable(unsigned number1Based)
+{
+    if (number1Based <= 0 || number1Based > 99)
+        return nullptr;
+    if (variables.size() < number1Based)
+        variables.resize(number1Based);
+    return &variables[number1Based - 1];
+}
+
+bool sfz::Region::addVariableTarget(const Opcode& opcode, const ModKey& target, OpcodeSpec<float> spec)
+{
+    Variable* v = getOrCreateVariable(opcode.parameters.front());
+    if (!v)
+        return false;
+    auto it = absl::c_find_if(v->targets, [&target](const std::pair<ModKey, float>& t) { return t.first == target; });
+    if (it == v->targets.end())
+        it = v->targets.insert(v->targets.end(), { target, 0.0f });
+    it->second = opcode.read(spec);
+    return true;
+}
+
+void sfz::Region::buildVariableConnections()
+{
+    auto ccKey = [this](const Variable::Term& t) {
+        ModKey::Parameters p;
+        p.cc = t.cc;
+        p.curve = t.curve;
+        return ccModulationIsPerVoice(t.cc) ? ModKey(ModId::PerVoiceController, id, p) : ModKey(ModId::Controller, {}, p);
+    };
+
+    for (size_t vi = 0; vi < variables.size(); ++vi) {
+        const Variable& v = variables[vi];
+        if (v.terms.empty())
+            continue;
+        for (size_t ti = 0; ti < v.targets.size(); ++ti) {
+            const ModKey& target = v.targets[ti].first;
+            const float amount = v.targets[ti].second;
+            const bool multiplicativeTarget = (target.flags() & kModIsMultiplicative) != 0;
+
+            if (!v.multiply || v.terms.size() == 1) {
+                // a sum of CC terms: one connection each
+                for (const auto& t : v.terms)
+                    getOrCreateConnection(ccKey(t), target).sourceDepth = amount * t.depth;
+                continue;
+            }
+
+            // a product of CC terms: chain them through depth modulations, so each CC scales the
+            // next; all the depths go into the innermost link
+            float depth = amount;
+            for (const auto& t : v.terms)
+                depth *= t.depth;
+            const size_t n = v.terms.size();
+            auto link = [&](size_t j) { return ModKey::createNXYZ(ModId::VariableDepth, id, vi, ti, j); };
+            getOrCreateConnection(ccKey(v.terms[n - 1]), link(n - 1)).sourceDepth = depth;
+            for (size_t j = n - 1; j-- > 1;) {
+                Connection& c = getOrCreateConnection(ccKey(v.terms[j]), link(j));
+                c.sourceDepth = 0.0f;
+                c.sourceDepthMod = link(j + 1);
+            }
+            Connection& c = getOrCreateConnection(ccKey(v.terms[0]), target);
+            c.sourceDepth = multiplicativeTarget ? 1.0f : 0.0f;
+            c.sourceDepthMod = link(1);
+        }
+    }
+}
