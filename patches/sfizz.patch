 #include <string>
 
 namespace sfz {
@@ -2892,9 +2893,23 @@ end_control:
     return opcode;
 }
 
+// SFZ v1 spellings the rules above miss; kept out of them so the generated file needn't be rebuilt
+static std::string cleanUpV1Aliases(std::string opcode)
+{
+    for (absl::string_view prefix : { "fileg_depthcc", "pitcheg_depthcc" }) {
+        absl::string_view rest = absl::string_view(opcode).substr(std::min(opcode.size(), prefix.size()));
+        if (absl::StartsWith(opcode, prefix) && !rest.empty() && rest.find_first_not_of("0123456789") == rest.npos)
+            return absl::StrCat(prefix.substr(0, prefix.size() - 2), "_oncc", rest);
+    }
+    return opcode;
+}
+
 Opcode Opcode::cleanUp(OpcodeScope scope) const
 {
-    return Opcode(cleanUpOpcodeName(name, scope), value);
+    std::string cleaned = cleanUpOpcodeName(name, scope);
+    if (scope == kOpcodeScopeRegion)
+        cleaned = cleanUpV1Aliases(std::move(cleaned));
+    return Opcode(cleaned, value);
 }
 
 } // namespace sfz
